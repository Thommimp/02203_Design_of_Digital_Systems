        <mxCell id="5HOrP3V9G5vlaYquKcFQ-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=3;strokeWidth=2;labelBackgroundColor=none;" value="&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;function automatic logic [7:0] sobel(&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; input logic [7:0] s11, s12, s13,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; input logic [7:0] s21,&amp;nbsp; &amp;nbsp; &amp;nbsp; s23,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; input logic [7:0] s31, s32, s33&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;);&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; logic signed [10:0] dx, dy;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; logic&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; [10:0] adx, ady, sum;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; // rozszerzenie zerami do 11 bitów i rzutowanie na signed&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; dx = $signed({3&#39;b0, s13}) - $signed({3&#39;b0, s11})&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+ 2 * ($signed({3&#39;b0, s23}) - $signed({3&#39;b0, s21}))&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+ $signed({3&#39;b0, s33}) - $signed({3&#39;b0, s31});&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; dy = $signed({3&#39;b0, s11}) - $signed({3&#39;b0, s31})&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+ 2 * ($signed({3&#39;b0, s12}) - $signed({3&#39;b0, s32}))&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+ $signed({3&#39;b0, s13}) - $signed({3&#39;b0, s33});&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; // wartość bezwzględna&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; adx = (dx &amp;lt; 0) ? -dx : dx;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; ady = (dy &amp;lt; 0) ? -dy : dy;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; sum = adx + ady;&amp;nbsp; &amp;nbsp;// 0 .. 2040&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; // dopasowanie do zakresu 0..255 (wybierz jedno)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; return sum[10:3];&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // dzielenie przez 8&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; // return (sum &amp;gt; 255) ? 8&#39;d255 : sum[7:0];&amp;nbsp; &amp;nbsp;// nasycenie&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 12px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;endfunction&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="780" x="1150" y="-200" as="geometry" />
        </mxCell>
